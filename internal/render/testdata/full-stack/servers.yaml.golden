# vision/servers.yaml — generated by oca apply
# source: stack.example.toml

servers:
    context7:
        port: 6276
        command: npx
        args:
            - -y
            - '@upstash/context7-mcp@latest'
        autostart: true
        request_timeout: 10000ms
        source: https://github.com/upstash/context7
        description: Library and API documentation lookup
    firecrawl:
        port: 6281
        command: npx
        args:
            - -y
            - '@mendableai/firecrawl-mcp@latest'
        autostart: true
        request_timeout: 15000ms
        source: https://github.com/mendableai/firecrawl
        description: Web scraping and crawl
    grep-app:
        port: 6288
        command: npx
        args:
            - -y
            - '@grep-app/mcp@latest'
        autostart: true
        request_timeout: 5000ms
        source: https://grep.app
        description: Cross-repo code example search
    kagi:
        port: 6279
        command: uvx
        args:
            - --from
            - kagimcp
            - kagimcp
        autostart: true
        request_timeout: 15000ms
        source: https://github.com/kagisearch/kagimcp
        description: Kagi Search API for fetch and summarizer
    lgrep:
        port: 6285
        command: uvx
        args:
            - --from
            - git+https://github.com/Sharper-Flow/lgrep.git
            - lgrep
        env:
            LGREP_AUTO_WATCH: "true"
        autostart: true
        request_timeout: 5000ms
        source: https://github.com/Sharper-Flow/lgrep
        description: Semantic local code search + symbol indexing
    playwright:
        port: 6287
        command: npx
        args:
            - -y
            - '@playwright/mcp@latest'
        autostart: true
        request_timeout: 30000ms
        source: https://github.com/microsoft/playwright-mcp
        description: Browser automation
    sentry:
        port: 6289
        command: npx
        args:
            - -y
            - '@sentry/mcp-server@latest'
        autostart: true
        request_timeout: 15000ms
        source: https://github.com/getsentry/sentry-mcp
        description: Sentry error tracking and root cause analysis
    svelte-mcp:
        port: 6278
        command: npx
        args:
            - -y
            - '@sveltejs/mcp@latest'
        autostart: true
        request_timeout: 10000ms
        source: https://github.com/sveltejs/mcp
        description: Svelte 5 / SvelteKit documentation and autofixer
