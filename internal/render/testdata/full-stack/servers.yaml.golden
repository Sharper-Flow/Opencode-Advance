# vision/servers.yaml — generated by oca apply
# source: stack.example.toml

servers:
    context7:
        port: 6276
        command: context7-mcp
        autostart: true
        request_timeout: 10000ms
        source: https://github.com/upstash/context7
        description: Library and API documentation lookup
    firecrawl:
        port: 6281
        command: npx
        args:
            - -y
            - '@mendableai/firecrawl-mcp@latest'
        autostart: true
        request_timeout: 15000ms
        source: https://github.com/mendableai/firecrawl
        description: Web scraping and crawl
    kagi:
        port: 6279
        command: uvx
        args:
            - --python
            - "3.12"
            - kagimcp
        autostart: true
        request_timeout: 15000ms
        source: https://github.com/kagisearch/kagimcp
        description: Kagi Search API for fetch and summarizer
    lgrep:
        port: 6285
        command: lgrep
        env:
            LGREP_AUTO_WARM_DISK: "false"
            LGREP_AUTO_WATCH: "false"
        autostart: true
        request_timeout: 5000ms
        source: https://github.com/Sharper-Flow/lgrep
        description: Semantic local code search + symbol indexing
    sentry:
        port: 6289
        command: sentry-mcp
        autostart: true
        request_timeout: 15000ms
        source: https://github.com/getsentry/sentry-mcp
        description: Sentry error tracking and root cause analysis
    svelte-mcp:
        port: 6278
        command: svelte-mcp
        autostart: true
        request_timeout: 10000ms
        source: https://github.com/sveltejs/cli
        description: Svelte 5 / SvelteKit documentation and autofixer
slot_groups:
    playwright-auth:
        template: playwright-auth
        base_port: 6309
        count: 2
        group_port: 6308
        defaults:
            command: npx
            args:
                - playwright-mcp
                - --headless
    playwright-headed:
        template: playwright-headed
        base_port: 6306
        count: 2
        group_port: 6305
        defaults:
            command: npx
            args:
                - playwright-mcp
    playwright-headless:
        template: playwright-headless
        base_port: 6301
        count: 4
        group_port: 6300
        defaults:
            command: npx
            args:
                - playwright-mcp
                - --headless
